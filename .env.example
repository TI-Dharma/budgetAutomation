PORT=3000

# Credenciais e URL da API REST do Protheus
PROTHEUS_API_URL=http://SEU_IP_PROTHEUS:PORTA/rest
PROTHEUS_USER=seu_usuario
PROTHEUS_PASS=sua_senha
PROTHEUS_TENANT=01,0101

# Credenciais do Bitrix24
BITRIX_WEBHOOK_URL=https://seu-portal.bitrix24.com.br/rest/1/seu_token/

# Rota de atualização/unificação de orçamentos (/webhook/bitrix/quote/process)
BITRIX_QUOTE_PRICE_UPDATED_STATUS=UC_1KJDXH
# Campos personalizados onde o CNPJ esta gravado (usados quando o webhook nao envia o cnpj)
BITRIX_QUOTE_CNPJ_FIELD=UF_CRM_5EF5FA28D794B
BITRIX_DEAL_CNPJ_FIELD=UF_CRM_1574685317
BITRIX_COMPANY_CNPJ_FIELD=UF_CRM_1568309909
CNPJ_API_URL=https://publica.cnpj.ws/cnpj/
PRICING_MARGIN_EXEMPT=0.30
PRICING_MARGIN_TAXPAYER=0.25

# PostgreSQL (tabelas sys_parameters e priceRadios)
PG_HOST=seu_host_postgres
PG_PORT=5432
PG_DATABASE=seu_banco
PG_USER=seu_usuario
PG_PASSWORD=sua_senha
PG_SSL=false

# Padrões da Oportunidade (FATA300) e Proposta (FATA600) - opcionais
PROTHEUS_DEFAULT_SALESMAN=000001
PROTHEUS_DEFAULT_PROCESS=000001
PROTHEUS_DEFAULT_STAGE=000001
