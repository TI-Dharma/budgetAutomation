PORT=4009

# Credenciais e URL da API REST do TOTVS Protheus
PROTHEUS_API_URL=https://192.168.0.80:8887/rest
PROTHEUS_USER=seu_usuario
PROTHEUS_PASS=sua_senha
PROTHEUS_TENANT=01,0101

# Padrões para Oportunidade (AD1 / FATA300) e Proposta Comercial (ADY/ADZ / FATA600)
PROTHEUS_DEFAULT_BRANCH=0101
PROTHEUS_DEFAULT_PAYMENT_TERM=043
PROTHEUS_DEFAULT_PRICE_TABLE=003
PROTHEUS_DEFAULT_DELIVERY_DAYS=10
PROTHEUS_DEFAULT_FREIGHT_TYPE=C
PROTHEUS_DEFAULT_SALESMAN=000001
PROTHEUS_DEFAULT_PROCESS=000001
PROTHEUS_DEFAULT_STAGE=000001

# Credenciais e Configuração do Bitrix24
BITRIX_WEBHOOK_URL=https://seu-portal.bitrix24.com.br/rest/1/seu_token/

# Status (STATUS_ID) das colunas do pipeline de Orçamentos (QUOTE_STATUS) no Bitrix24
BITRIX_QUOTE_DRAFT_STATUS=DRAFT
BITRIX_QUOTE_PRICE_UPDATED_STATUS=UC_1KJDXH
# Coluna de Erro/Falha no pipeline de Orçamentos (ex: APOLOGY = "Analisar recusa" ou ID da coluna "Erro")
BITRIX_QUOTE_ERROR_STATUS=APOLOGY

# Campos personalizados no Bitrix24
BITRIX_QUOTE_CNPJ_FIELD=UF_CRM_5EF5FA28D794B
BITRIX_DEAL_CNPJ_FIELD=UF_CRM_1574685317
BITRIX_COMPANY_CNPJ_FIELD=UF_CRM_1568309909
# Campo no Orçamento/Negócio onde é gravado o ID da Oportunidade/Proposta gerada no TOTVS
BITRIX_QUOTE_TOTVS_ID_FIELD=UF_CRM_5EF5FA2A0AAA7
BITRIX_DEAL_TOTVS_ID_FIELD=UF_CRM_1574778830

# API pública de consulta de CNPJ (UF, Inscrição Estadual e endereço)
CNPJ_API_URL=https://publica.cnpj.ws/cnpj/
